backend/spring/src/main/resources/application.properties

# Postman local files
backend/spring/.postman/
backend/spring/postman/

############################
# Frontend (React/Vue 등)
############################
frontend/node_modules/
frontend/dist/

############################
# Logs
############################
*.log

############################
# OS
############################
.DS_Store
Thumbs.db
frontend_old/

############################
# Secrets / local config
############################
# 키·토큰·서버 주소는 저장소에 올리지 않는다. 예시는 *.example 로만 둔다.
.env
.env.*
!.env.example
**/.env
**/.env.*
!**/.env.example

# 백엔드 로컬 설정 (Gemini·카카오 REST 키가 여기 들어간다)
backend/spring/src/main/resources/application-*.properties
backend/spring/src/main/resources/application*.yml
backend/spring/src/main/resources/application*.yaml

# 서명 키 (RN 기본 debug.keystore 만 예외로 둔다)
*.jks
*.p12
*.pem

# Firebase (FCM). 프로젝트마다 다르고 키가 들어 있어 올리지 않는다.
# 팀 공용 프로젝트에서 받아 frontend/android/app/ 에 직접 넣는다.
google-services.json
GoogleService-Info.plist
# 서버용 서비스 계정 키는 저장소 밖에 둔다. 혹시 넣더라도 막는다.
**/*firebase-adminsdk*.json
