{
  "info": {
    "name": "PinKok - Auth",
    "description": "로그인 기능 수동 테스트용 컬렉션. 위에서 아래 순서대로 실행하면 됩니다.\n\n1) Signup → 2) Login (accessToken 자동 저장) → 3) Get My Info\n\n서버: gradlew.bat bootRun (localhost:8080), MySQL(pinkok_db) 필요.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "email", "value": "me@test.com" },
    { "key": "username", "value": "jeonghun01" },
    { "key": "password", "value": "pass1234" },
    { "key": "nickname", "value": "정훈" },
    { "key": "accessToken", "value": "" },
    { "key": "avatarId", "value": "" }
  ],
  "item": [
    {
      "name": "0. Get Avatars (아바타 목록, 로그인 불필요)",
      "request": {
        "method": "GET",
        "header": [],
        "url": { "raw": "{{baseUrl}}/avatars", "host": ["{{baseUrl}}"], "path": ["avatars"] }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));",
              "const b = pm.response.json();",
              "if (Array.isArray(b) && b.length > 0) {",
              "  pm.collectionVariables.set('avatarId', b[0].id);",
              "  console.log('avatarId 저장:', b[0].id);",
              "} else {",
              "  console.log('아바타 시드 데이터가 아직 없습니다 (avatars 테이블이 비어있음). 회원가입 시 avatarId는 생략하세요.');",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "1. Signup (회원가입)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": { "raw": "{{baseUrl}}/auth/signup", "host": ["{{baseUrl}}"], "path": ["auth", "signup"] },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{email}}\",\n  \"username\": \"{{username}}\",\n  \"password\": \"{{password}}\",\n  \"nickname\": \"{{nickname}}\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('201 Created', () => pm.response.to.have.status(201));",
              "const b = pm.response.json();",
              "pm.test('응답에 id/email/nickname 포함', () => {",
              "  pm.expect(b).to.have.property('id');",
              "  pm.expect(b.email).to.eql(pm.variables.get('email'));",
              "  pm.expect(b.nickname).to.eql(pm.variables.get('nickname'));",
              "});",
              "pm.test('비밀번호 필드는 응답에 없어야 함', () => {",
              "  pm.expect(b).to.not.have.property('passwordHash');",
              "  pm.expect(b).to.not.have.property('password');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "2. Login (로그인)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));",
              "const b = pm.response.json();",
              "pm.test('accessToken 발급됨', () => pm.expect(b.accessToken).to.be.a('string').and.not.empty);",
              "pm.test('tokenType = Bearer', () => pm.expect(b.tokenType).to.eql('Bearer'));",
              "pm.collectionVariables.set('accessToken', b.accessToken);",
              "console.log('accessToken 저장 완료');"
            ]
          }
        }
      ]
    },
    {
      "name": "3. Get My Info (내 정보 조회)",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
        "url": { "raw": "{{baseUrl}}/users/me", "host": ["{{baseUrl}}"], "path": ["users", "me"] }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));",
              "const b = pm.response.json();",
              "pm.test('내 이메일/닉네임 반환', () => {",
              "  pm.expect(b.email).to.eql(pm.variables.get('email'));",
              "  pm.expect(b.nickname).to.eql(pm.variables.get('nickname'));",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "3b. Select Avatar (아바타 선택 · 변경)",
      "request": {
        "method": "PATCH",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{accessToken}}" }
        ],
        "url": { "raw": "{{baseUrl}}/users/me/avatar", "host": ["{{baseUrl}}"], "path": ["users", "me", "avatar"] },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"avatarId\": {{avatarId}}\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (!pm.collectionVariables.get('avatarId')) {",
              "  console.log('avatarId 변수가 비어있습니다. 먼저 0번 요청(Get Avatars)을 실행하거나, avatars 테이블에 시드 데이터를 넣으세요.');",
              "} else {",
              "  pm.test('200 OK', () => pm.response.to.have.status(200));",
              "  const b = pm.response.json();",
              "  pm.test('avatar 정보가 반영됨', () => pm.expect(b.avatar).to.not.be.null);",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "4. Login - 틀린 비밀번호 (401 기대)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"wrong-password\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": ["pm.test('401 Unauthorized', () => pm.response.to.have.status(401));"]
          }
        }
      ]
    },
    {
      "name": "5. Signup - 이메일 중복 (409 기대)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": { "raw": "{{baseUrl}}/auth/signup", "host": ["{{baseUrl}}"], "path": ["auth", "signup"] },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{email}}\",\n  \"username\": \"someoneelse\",\n  \"password\": \"pass1234\",\n  \"nickname\": \"다른사람\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": ["pm.test('409 Conflict', () => pm.response.to.have.status(409));"]
          }
        }
      ]
    },
    {
      "name": "6. Get My Info - 토큰 없음 (401 기대)",
      "request": {
        "method": "GET",
        "header": [],
        "url": { "raw": "{{baseUrl}}/users/me", "host": ["{{baseUrl}}"], "path": ["users", "me"] }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": ["pm.test('401 Unauthorized', () => pm.response.to.have.status(401));"]
          }
        }
      ]
    }
  ]
}
