# 이 파일을 .env 로 복사한 뒤 값을 채운다. .env 는 커밋되지 않는다.
#
#   cp .env.example .env

# 백엔드 주소. cloudflared 터널을 쓰면 뜰 때마다 바뀐다.
# adb reverse tcp:8080 tcp:8080 으로 고정하려면 http://localhost:8080 을 쓴다.
API_BASE_URL=http://localhost:8080

# 카카오 개발자 콘솔 > 내 애플리케이션 > 앱 키 > JavaScript 키
# 클라이언트 키라 앱 번들에 그대로 들어간다. 숨길 수 없는 값이므로 콘솔의
# 도메인 제한으로 보호한다. 서버가 쓰는 REST API 키와는 다른 키이고,
# 그쪽은 절대 앱에 넣지 않는다.
KAKAO_JS_KEY=

# 콘솔의 [JavaScript 키 > JavaScript SDK 도메인] 에 등록한 주소를 그대로 적는다.
# 포트까지 한 글자라도 다르면 지도가 뜨지 않는다.
KAKAO_SDK_ORIGIN=https://localhost:8080
