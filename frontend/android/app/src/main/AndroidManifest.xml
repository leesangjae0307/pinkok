<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- 장소 기록 영상 촬영 -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- 완성한 PinLog 를 갤러리에 저장. 13(33) 이상은 READ_MEDIA_VIDEO 를 쓴다. -->
    <uses-permission
      android:name="android.permission.WRITE_EXTERNAL_STORAGE"
      android:maxSdkVersion="28" />
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />
    <!-- 안드로이드 13(API 33)부터는 알림을 띄우려면 사용자에게 물어봐야 한다. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- 카메라가 없는 기기에도 설치될 수 있게 required 는 끈다. -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />

    <application
      android:name=".MainApplication"
      android:label="@string/app_name"
      android:icon="@mipmap/ic_launcher"
      android:roundIcon="@mipmap/ic_launcher_round"
      android:allowBackup="false"
      android:theme="@style/AppTheme"
      android:supportsRtl="true">
      <!--
        화면은 세로로 고정한다. 모든 화면이 세로 기준으로 짜여 있고, 촬영 화면에서
        휴대폰을 돌려도 촬영 버튼이 좌우로 따라다니면 안 되기 때문이다.
        돌린 방향은 Camera 의 outputOrientation="device" 가 따로 읽어서,
        가로로 들고 찍으면 영상은 그대로 가로로 저장된다.
      -->
      <activity
        android:name=".MainActivity"
        android:label="@string/app_name"
        android:configChanges="keyboard|keyboardHidden|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
        android:screenOrientation="portrait"
        android:launchMode="singleTask"
        android:windowSoftInputMode="adjustResize"
        android:exported="true">
        <intent-filter>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent-filter>
      </activity>
    </application>
</manifest>
