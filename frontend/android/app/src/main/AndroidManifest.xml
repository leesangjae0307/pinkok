<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- 장소 기록 영상 촬영 -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- 완성한 PinLog 를 갤러리에 저장. 13(33) 이상은 READ_MEDIA_VIDEO 를 쓴다. -->
    <uses-permission
      android:name="android.permission.WRITE_EXTERNAL_STORAGE"
      android:maxSdkVersion="28" />
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />

    <!-- 카메라가 없는 기기에도 설치될 수 있게 required 는 끈다. -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />

    <application
      android:name=".MainApplication"
      android:label="@string/app_name"
      android:icon="@mipmap/ic_launcher"
      android:roundIcon="@mipmap/ic_launcher_round"
      android:allowBackup="false"
      android:theme="@style/AppTheme"
      android:supportsRtl="true">
      <!--
        화면은 세로로 고정한다.

        PinLog 클립은 가로(16:9)로 찍어야 해서 사용자가 촬영 중에 휴대폰을 가로로
        돌린다. UI 까지 같이 돌아가면 촬영 버튼이 화면 옆으로 옮겨가 엄지가 닿지
        않는다. 세로로 고정해 두면 버튼은 늘 휴대폰 세로 기준 아래쪽에 머물고,
        영상은 vision-camera 의 outputOrientation="device" 가 기기를 쥔 방향으로
        저장해 준다(RecordClipModal). 나머지 화면도 모두 세로 전용 디자인이다.
      -->
      <activity
        android:name=".MainActivity"
        android:label="@string/app_name"
        android:screenOrientation="portrait"
        android:configChanges="keyboard|keyboardHidden|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
        android:launchMode="singleTask"
        android:windowSoftInputMode="adjustResize"
        android:exported="true">
        <intent-filter>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent-filter>
      </activity>
    </application>
</manifest>
