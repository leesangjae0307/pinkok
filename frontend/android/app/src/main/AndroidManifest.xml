<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- 장소 기록 영상 촬영 -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!--
      완성한 PinLog 를 갤러리에 저장.
      10(API 29) 이상은 MediaStore 로 저장하므로 권한이 필요 없고, 9 이하만 받는다.
      갤러리에서 고를 때도 시스템 선택기가 고른 파일만 건네주므로 READ_MEDIA_* 는 쓰지 않는다.
    -->
    <uses-permission
      android:name="android.permission.WRITE_EXTERNAL_STORAGE"
      android:maxSdkVersion="28" />
    <!-- 안드로이드 13(API 33)부터는 알림을 띄우려면 사용자에게 물어봐야 한다. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- 카메라가 없는 기기에도 설치될 수 있게 required 는 끈다. -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />

    <!--
      enableOnBackInvokedCallback 은 꺼 둔다.
      안드로이드 16(API 36) 부터는 targetSdk 가 36 이면 예측형 뒤로가기가 기본으로
      켜진다. 그러면 시스템이 뒤로가기를 직접 처리해서 Activity 의 onBackPressed 가
      호출되지 않고, 그 위에 얹힌 RN 의 BackHandler 도 신호를 받지 못한다. 화면
      하나만 보고 있어도 앱이 통째로 꺼지던 이유가 이것이다. 예측형 뒤로가기
      애니메이션을 아직 지원하지 않으므로 끈다.
    -->
    <application
      android:name=".MainApplication"
      android:label="@string/app_name"
      android:icon="@mipmap/ic_launcher"
      android:roundIcon="@mipmap/ic_launcher_round"
      android:allowBackup="false"
      android:theme="@style/AppTheme"
      android:supportsRtl="true"
      android:enableOnBackInvokedCallback="false">
      <!--
        화면은 세로로 고정한다. 모든 화면이 세로 기준으로 짜여 있고, 촬영 화면에서
        휴대폰을 돌려도 촬영 버튼이 좌우로 따라다니면 안 되기 때문이다.
        돌린 방향은 Camera 의 outputOrientation="device" 가 따로 읽어서,
        가로로 들고 찍으면 영상은 그대로 가로로 저장된다.
      -->
      <activity
        android:name=".MainActivity"
        android:label="@string/app_name"
        android:configChanges="keyboard|keyboardHidden|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
        android:screenOrientation="portrait"
        android:launchMode="singleTask"
        android:windowSoftInputMode="adjustResize"
        android:exported="true">
        <intent-filter>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent-filter>
      </activity>
    </application>
</manifest>
